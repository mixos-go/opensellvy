{
  "name": "opensellvy",
  "version": "0.0.1",
  "description": "Omnichannel OMS SDK for Indonesian ecommerce platforms",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./db": {
      "import": "./dist/db/index.js",
      "types": "./dist/db/index.d.ts"
    },
    "./modules": {
      "import": "./dist/module/index.js",
      "types": "./dist/module/index.d.ts"
    },
    "./connectors": {
      "import": "./dist/connector/index.js",
      "types": "./dist/connector/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/api/index.ts",
    "start": "node dist/api/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0",
    "hono": "^4.0.0",
    "@hono/node-server": "^1.0.0",
    "graphql": "^16.8.0",
    "graphql-yoga": "^5.0.0",
    "jose": "^5.0.0",
    "zod": "^3.22.0",
    "pino": "^8.0.0",
    "pino-pretty": "^10.0.0",
    "emittery": "^1.0.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0",
    "drizzle-kit": "^0.20.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "author": "Bagas Ferianto Al Fariz"
}

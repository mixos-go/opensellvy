{
  "name": "@opensellvy/db-pg",
  "version": "0.0.1",
  "description": "Postgres repository adapter (@opensellvy/module ports) via Drizzle query builder + raw SQL migrations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensellvy/types": "workspace:*",
    "@opensellvy/module": "workspace:*",
    "@opensellvy/db": "workspace:*",
    "@opensellvy/core": "workspace:*",
    "drizzle-orm": "^0.43.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@opensellvy/connector": "workspace:*",
    "@types/pg": "^8.11.10"
  },
  "license": "MIT"
}

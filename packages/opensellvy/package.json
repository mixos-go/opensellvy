{
  "name": "opensellvy",
  "version": "0.0.1",
  "description": "Omnichannel OMS SDK - umbrella entry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensellvy/types": "workspace:*",
    "@opensellvy/core": "workspace:*",
    "@opensellvy/db": "workspace:*",
    "@opensellvy/connector": "workspace:*",
    "@opensellvy/module": "workspace:*",
    "@opensellvy/api": "workspace:*"
  },
  "license": "MIT"
}
{
  "name": "@opensellvy/platform-shopee",
  "version": "0.0.1",
  "description": "Shopee connector plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "generate": "tsx scripts/generate-api.ts",
    "auth": "tsx auth-flow.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opensellvy/connector": "workspace:*",
    "@opensellvy/core": "workspace:^",
    "@opensellvy/types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "license": "MIT"
}

{
  "name": "@opensellvy/platform-tts-tokopedia",
  "version": "0.0.1",
  "description": "TikTok Shop connector plugin (platform code: tts-tokopedia)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "auth": "tsx scripts/auth-flow.ts",
    "live:gateway": "tsx scripts/live-gateway.ts"
  },
  "dependencies": {
    "@opensellvy/types": "workspace:*",
    "@opensellvy/connector": "workspace:*"
  },
  "license": "MIT"
}

{
  "name": "@opensellvy/sdk",
  "version": "0.0.1",
  "description": "Omnichannel OMS SDK — umbrella entry (types, core, connector, module, api, db, db-pg)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./connector": {
      "import": "./dist/connector.js",
      "types": "./dist/connector.d.ts"
    },
    "./module": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./db": {
      "import": "./dist/db.js",
      "types": "./dist/db.d.ts"
    },
    "./db-pg": {
      "import": "./dist/db-pg.js",
      "types": "./dist/db-pg.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/connector.ts src/module.ts src/api.ts src/core.ts src/db.ts src/db-pg.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opensellvy/types": "workspace:*",
    "@opensellvy/core": "workspace:*",
    "@opensellvy/connector": "workspace:*",
    "@opensellvy/module": "workspace:*",
    "@opensellvy/api": "workspace:*",
    "@opensellvy/db": "workspace:*",
    "@opensellvy/db-pg": "workspace:*"
  },
  "license": "MIT"
}

{
  "name": "@opensellvy/ui",
  "version": "0.0.1",
  "description": "UI components (shadcn/ui) untuk dashboard OMS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
"exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/globals.css"
